#!/bin/sh
# Pakon: the app (/opt/pakon/pakon, the service in a WebKitGTK window).
# Data in ~/.local/share/pakon, the log in ~/.local/state/pakon/pakon.log.
# The version and the report server are in /opt/pakon/release.env, which the
# app reads itself.
export PAKON_DATA="${PAKON_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/pakon}"
LOGS="${XDG_STATE_HOME:-$HOME/.local/state}/pakon"
export PAKON_LOGS="$LOGS"
mkdir -p "$PAKON_DATA" "$LOGS"
exec /opt/pakon/pakon "$@" >>"$LOGS/pakon.log" 2>&1
