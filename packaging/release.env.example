# Copy to release.env (git-ignored) to build a release, macOS or Linux, that
# can send opt-in crash reports and usage statistics to your Rybbit instance
# (rybbit.com).
# Leave it out and the app never sends any, and never asks.
PAKON_RYBBIT_URL=https://rybbit.example.com
PAKON_RYBBIT_SITE_ID=your-site-id
PAKON_RYBBIT_DOMAIN=pakon.example.com
