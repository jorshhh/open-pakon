# Copy to .env (git-ignored) and build.py picks these up. Variables set in
# the shell win over this file.

# The site's address, for canonical links, the sitemap and social previews.
SITE_URL=https://openpakon.com

# Visit counting with Rybbit (rybbit.com). Leave either out and the pages
# get no analytics script.
RYBBIT_URL=https://rybbit.example.com
RYBBIT_SITE_ID=your-site-id
